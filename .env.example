# Local development environment (copy to `.env` and fill values)

# LLM usage in UI and local generation rerank
OPENAI_API_KEY=

# Optional: host-run Streamlit backend URL
MTG_GCP_BACKEND_URL=http://localhost:8080/v1/deck/recommend
MTG_GCP_RESEARCH_URL=http://localhost:8080/v1/research/run
MTG_GCP_CHAT_URL=http://localhost:8080/v1/chat/respond

# Optional: Docker Compose internal backend URL override
# MTG_COMPOSE_BACKEND_URL=http://mtg-backend:8080/v1/deck/recommend
MTG_LOCAL_RETRIEVER_ENABLE_SEMANTIC=false
MTG_BACKEND_MODE=local
MTG_VERTEX_FALLBACK_TO_LOCAL=true
MTG_VERTEX_PROXY_RESEARCH=false
MTG_VERTEX_PROXY_CHAT=false
MTG_VERTEX_AGENT_ENGINE_RESOURCE=
MTG_VERTEX_AGENT_ENGINE_TIMEOUT_SEC=60
MTG_LLM_PROVIDER=openai
MTG_OPENAI_MODEL=gpt-4o-mini
MTG_OPENAI_API_KEY_ENV=OPENAI_API_KEY
MTG_OPENAI_BASE_URL=https://api.openai.com/v1
MTG_VERTEX_MODEL=gemini-2.5-flash
MTG_LLM_TIMEOUT_SEC=45
MTG_RAG_CORPUS_URI=
MTG_EVAL_DATASET_URI=eval/topics.jsonl
MTG_GCS_CACHE_DIR=.cache/mtg_gcs
MTG_CHAT_ENABLE_CLARIFICATION=true
MTG_CHAT_MAX_CLARIFICATION_TURNS=1

# Local backend adapter defaults
HOST=0.0.0.0
PORT=8080

# Optional telemetry / evaluation fan-out
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mtg-deck-builder
LANGSMITH_OTEL_ENABLED=false

# Model lifecycle override (optional)
# MODEL_EOL_GEMINI_2_5_PRO=2026-06-17

# Optional deploy helpers (used by scripts/commands, not required for local app)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=
